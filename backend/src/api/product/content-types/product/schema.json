{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Data utama kategori produk: tampil di Products Overview (home) & submenu navbar, jadi pintu masuk ke halaman per kategori"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "category_key": {
      "type": "enumeration",
      "enum": ["roder", "sarnafil", "peralatan-pendukung"],
      "required": true,
      "unique": true
    },
    "display_order": {
      "type": "integer",
      "default": 0
    }
  }
}
