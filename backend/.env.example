HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database — read by config/database.ts.
# Leave DATABASE_CLIENT unset and Strapi falls back to sqlite (.tmp/data.db),
# which is NOT what this project wants. Set it explicitly.
DATABASE_CLIENT=postgres

# Neon: use the POOLED connection string (host contains "-pooler") and keep
# sslmode=require. DATABASE_URL is parsed by pg and its fields WIN over the
# DATABASE_HOST / DATABASE_PORT / DATABASE_NAME / DATABASE_USERNAME /
# DATABASE_PASSWORD vars below — set the URL or the parts, not both.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_SSL=true
DATABASE_SCHEMA=public

# Optional tuning (defaults shown).
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=60000

# Only used when DATABASE_CLIENT=sqlite.
# DATABASE_FILENAME=.tmp/data.db
