# Next.js + Payload 3.
#
# The CMS runs inside this app — there is no separate backend service, so there
# is no base URL and no API token to configure. Copy this file to .env and fill
# in the values below.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs auth tokens and encrypts stored credentials. Use a different value per
# environment, and never reuse the development one in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Neon Postgres. Use the POOLED connection string — its host contains
# "-pooler" — because serverless functions open many short-lived connections.
#
# `sslmode=verify-full` is deliberate: `require` works, but pg logs a
# deprecation warning on every boot that Next surfaces as a console error.
DATABASE_URI="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/payload?sslmode=verify-full"

# ---------------------------------------------------------------------------
# Cloudflare R2 — media storage
# ---------------------------------------------------------------------------
#
# Uploads go to R2 only when all four variables below are set. Leave any of
# them empty and Payload falls back to the local filesystem, which is fine for
# a quick local run but must never be deployed: serverless filesystems are
# wiped on every redeploy.
#
# From the R2 dashboard:
#   R2_ENDPOINT  R2 > Overview > Account ID, as https://<account-id>.r2.cloudflarestorage.com
#                Do NOT append the bucket name — the S3 client adds it, and a
#                doubled path silently stores objects under the wrong key.
#   keys         R2 > Manage API tokens > Create Account API token (Object Read & Write)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Public base URL for READING media. Leave empty and Payload streams files
# itself through /api/media/file/<filename>, which works everywhere including
# production — it just spends serverless function time on every image.
#
# Set it to a custom domain attached to the bucket (R2 > bucket > Settings >
# Custom Domain), e.g. https://media.adi-indotent.com, to serve straight from
# Cloudflare's CDN instead. Adding a hostname here also requires adding it to
# images.remotePatterns in next.config.ts.
#
# Do not use the pub-<hash>.r2.dev URL: the whole r2.dev domain is blocked by
# Internet Positif on Indonesian ISPs, so those images fail to load for a large
# share of the audience.
R2_PUBLIC_URL=

# Absolute origin this site is served from, no trailing slash, e.g.
# https://adi-indotent.com
#
# Optional locally — it falls back to http://localhost:3000. Production MUST
# set it: canonical tags, og:url and every sitemap.xml entry are built from
# this, so leaving it unset ships a sitemap full of localhost URLs and tells
# Google the real pages do not exist.
NEXT_PUBLIC_SITE_URL=
