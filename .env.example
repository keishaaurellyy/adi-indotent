# Frontend (Next.js) environment.
#
# The frontend no longer connects to a database directly — the Drizzle/Neon
# layer moved to the Strapi backend. The Neon connection string now lives in
# backend/.env (see backend/.env.example).
#
# Copy this file to .env.local and fill in the real value.

# Base URL of the Strapi backend. Defaults to the local Strapi dev server.
NEXT_PUBLIC_STRAPI_URL="http://localhost:1337"
