# Next.js + Payload 3.
#
# The CMS runs inside this app — there is no separate backend service, so there
# is no base URL and no API token to configure. Copy this file to .env and fill
# in the values below.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs auth tokens and encrypts stored credentials. Use a different value per
# environment, and never reuse the development one in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Neon Postgres. Use the POOLED connection string — its host contains
# "-pooler" — because serverless functions open many short-lived connections.
#
# `sslmode=verify-full` is deliberate: `require` works, but pg logs a
# deprecation warning on every boot that Next surfaces as a console error.
DATABASE_URI="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/payload?sslmode=verify-full"

# ---------------------------------------------------------------------------
# Cloudflare R2 — media storage
# ---------------------------------------------------------------------------
#
# Uploads go to R2 only when all four variables below are set. Leave any of
# them empty and Payload falls back to the local filesystem, which is fine for
# a quick local run but must never be deployed: serverless filesystems are
# wiped on every redeploy.
#
# From the R2 dashboard:
#   R2_ENDPOINT  R2 > Overview > Account ID, as https://<account-id>.r2.cloudflarestorage.com
#                Do NOT append the bucket name — the S3 client adds it, and a
#                doubled path silently stores objects under the wrong key.
#   keys         R2 > Manage API tokens > Create Account API token (Object Read & Write)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Public base URL for READING media, no trailing slash. Leave empty and Payload
# streams files itself through /api/media/file/<filename>. That works, but every
# uncached image then cold-starts a function, boots Payload and queries Neon,
# which can take ~10 s and leaves product photos blank on first load.
#
# Either of these skips all of that:
#
#   https://pub-<hash>.r2.dev  R2 > bucket > Settings > Public Development URL.
#       The whole r2.dev domain is blocked by Internet Positif on Indonesian
#       ISPs, so browsers are never sent there: the site serves the files at
#       /media/<filename> and proxies them to r2.dev (see src/lib/media-url.ts).
#       No next.config.ts change needed. Leave it EMPTY for local dev on an
#       Indonesian connection: there the proxy runs on your machine, which
#       cannot reach r2.dev either.
#
#   A custom domain on the bucket, e.g. https://media.adi-indotent.com
#       (R2 > bucket > Settings > Custom Domain; the zone must be on
#       Cloudflare). Linked directly, served from Cloudflare's CDN. Also add
#       its hostname to images.remotePatterns in next.config.ts.
#
# Read at build time by next.config.ts, so changing it needs a redeploy.
R2_PUBLIC_URL=

# Absolute origin this site is served from, no trailing slash, e.g.
# https://adi-indotent.com
#
# Optional everywhere: an explicit value wins, but without one the site works
# out its own origin — https://adi-indotent.com on the Vercel production
# deployment, the deployment host on previews, http://localhost:3000 locally.
# Canonical tags, og:url and every sitemap.xml entry are built from it.
#
# Vercel previews (including staging) are also marked noindex and closed off in
# robots.txt, so they cannot compete with the live site in search.
NEXT_PUBLIC_SITE_URL=
